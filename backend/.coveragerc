[run]
source = app
branch = True
omit =
    */tests/*
    */migrations/*
    */__init__.py
    main.py

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:

show_missing = True
skip_empty = True
precision = 1

[html]
directory = htmlcov
